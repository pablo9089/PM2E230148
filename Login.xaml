<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PM2E230148.Login"
             Title="Iniciar sesión"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label Text="Bienvenido" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="White" />

            <Label Text="Inicia sesión con tu cuenta para continuar" 
                   FontSize="14" 
                   TextColor="#B0B0B0" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,20"/>

            <Entry x:Name="EntryCorreo" 
                   Placeholder="Correo electrónico" 
                   PlaceholderColor="#888888"
                   TextColor="White"
                   BackgroundColor="#1E1E1E"
                   Keyboard="Email" />

            <Entry x:Name="EntryClave" 
                   Placeholder="Contraseña" 
                   PlaceholderColor="#888888"
                   TextColor="White"
                   BackgroundColor="#1E1E1E"
                   IsPassword="True" />

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <CheckBox x:Name="CheckBoxMostrar" 
                          CheckedChanged="OnMostrarClaveChanged" 
                          Color="#2563EB" />
                <Label Text="Mostrar contraseña" 
                       TextColor="White"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button x:Name="BtnLogin" 
                    Text="Iniciar sesión" 
                    Clicked="OnLoginClicked" 
                    BackgroundColor="#2563EB" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    Margin="0,10,0,0"/>

            <ActivityIndicator x:Name="ActivityCarga" 
                               IsRunning="False" 
                               IsVisible="False" 
                               HorizontalOptions="Center" 
                               Color="#2563EB"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>