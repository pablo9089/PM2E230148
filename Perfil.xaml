<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PM2E230148.Perfil"
             Title="Perfil de Colaborador"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <Border x:Name="BorderContenedor" 
                    StrokeThickness="1" 
                    Stroke="#CBD5E1"
                    BackgroundColor="#DCFCE7"
                    Padding="20" 
                    StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="15">

                    <Label Text="Perfil de Usuario" 
                           FontAttributes="Bold" 
                           FontSize="18" 
                           TextColor="#475569"/>

                    <Label x:Name="LblNombre" 
                           Text="Cargando..." 
                           FontSize="22" 
                           FontAttributes="Bold"
                           TextColor="#0F172A"/>

                    <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                        <Switch x:Name="SwitchDisponible" 
                                IsToggled="True"
                                OnColor="#2563EB"/>
                        <Label Text="Disponible para trabajar" 
                               VerticalOptions="Center" 
                               FontSize="16"
                               TextColor="#334155"/>
                    </HorizontalStackLayout>

                    <Label x:Name="LblAnios" 
                           Text="0 años de experiencia" 
                           FontSize="16"
                           TextColor="#334155"/>

                    <Slider x:Name="SliderExperiencia" 
                            Minimum="0" 
                            Maximum="15" 
                            Value="0" 
                            ThumbColor="#2563EB"
                            MinimumTrackColor="#2563EB"
                            MaximumTrackColor="#94A3B8"
                            ValueChanged="OnSliderValueChanged"/>

                    <Label x:Name="LblNivel" 
                           Text="Nivel Inicial" 
                           FontAttributes="Bold" 
                           FontSize="16" 
                           TextColor="#1E3A8A"/>

                </VerticalStackLayout>
            </Border>

            <Button Text="Cerrar sesión" 
                    Clicked="OnCerrarSesionClicked" 
                    BackgroundColor="#DC2626" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>